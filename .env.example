# Required for form/pop-up testing
TEST_TARGET_URL=https://example.com
FORM_SELECTOR=form
FORM_SUCCESS_SELECTOR=
FORM_SUCCESS_URL_CONTAINS=
FORM_SUBMIT_SELECTOR=button[type="submit"]

# Optional custom selector overrides (comma-separated)
POPUP_CLOSE_SELECTORS=button[aria-label*="close" i],button:has-text("Close"),button:has-text("No thanks")

# Twilio module
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
TWILIO_TEST_MODE=otp
TWILIO_OTP_REGEX=\\b(\\d{4,8})\\b
TWILIO_EXPECTED_FROM=
OTP_PAGE_URL=
OTP_FIELD_SELECTOR=input[name="otp"]
OTP_SUBMIT_SELECTOR=button[type="submit"]

# MXToolbox + domain checks
MXTOOLBOX_API_KEY=
DOMAIN_TARGETS=example.com
IP_TARGETS=8.8.8.8
ALERT_WEBHOOK_URL=
