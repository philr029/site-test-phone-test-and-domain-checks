# Execution and environment
TEST_ENVIRONMENT=production
TARGET_NAME=

# Notification provider and webhook
NOTIFIER_PROVIDER=
NOTIFIER_WEBHOOK_URL=

# Dashboard local API (npm run dev:api)
DASHBOARD_API_PORT=3847
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_PORT=8080

# Twilio phone line tests (outbound call checks)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TEST_CALL_TWIML_URL=http://demo.twilio.com/docs/voice.xml
TWILIO_CALL_TIMEOUT_SEC=25
TWILIO_STATUS_CALLBACK_URL=

# Twilio SMS/OTP verification module (optional legacy flow)
TWILIO_TO_NUMBER=
TWILIO_TEST_MODE=otp
TWILIO_OTP_REGEX=\\b(\\d{4,8})\\b
TWILIO_EXPECTED_FROM=
TWILIO_OTP_TIMEOUT_MS=60000
OTP_PAGE_URL=
OTP_FIELD_SELECTOR=input[name="otp"]
OTP_SUBMIT_SELECTOR=button[type="submit"]

# MXToolbox (optional — fallback DNS checks run when missing)
MXTOOLBOX_API_KEY=

# Optional reputation APIs (placeholders in dashboard until configured)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
HETRIXTOOLS_API_KEY=
