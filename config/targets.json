{
  "environment": "production",
  "defaults": {
    "popupCloseSelectors": [
      "button[aria-label*='close' i]",
      "button:has-text('Close')",
      "button:has-text('No thanks')",
      "button:has-text('Accept')",
      "button:has-text('Reject')",
      "button:has-text('Dismiss')"
    ]
  },
  "targets": [
    {
      "name": "example-site",
      "enabled": true,
      "website": {
        "url": "https://example.com",
        "formUrl": "https://example.com",
        "safeToSubmit": false,
        "formSelector": "form",
        "submitSelector": "button[type='submit']",
        "successSelector": "",
        "successUrlContains": "",
        "expectedSuccessText": "Thank you",
        "fields": [],
        "popupChecks": [
          {
            "name": "Cookie Banner",
            "selector": "#cookie-banner",
            "expectedText": "",
            "critical": false
          },
          {
            "name": "Live Chat",
            "selector": ".live-chat-widget",
            "expectedText": "",
            "critical": true
          }
        ]
      },
      "phone": {
        "enabled": false,
        "number": "+441234567890",
        "expectedBehaviour": "should ring"
      },
      "domain": {
        "enabled": true,
        "domain": "example.com",
        "ip": "8.8.8.8"
      }
    }
  ]
}
